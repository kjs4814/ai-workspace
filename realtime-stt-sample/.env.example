# --- 필수 ---
# RAG Suite 프록시 주소. 끝에 /v1 을 붙이지 않는다.
# 값에 < > 같은 기호를 남겨두면 셸이 리다이렉션으로 해석해 실행이 깨진다.
RAG_SUITE_BASE_URL=https://YOUR-PROXY-ID.proxy.dxg.aifoundry.ktcloud.com
RAG_SUITE_TOKEN=kt_YOUR_TOKEN_HERE

# --- 선택 ---
STT_LANGUAGE=ko
STT_INTERIM=1

# --- 외부에 노출할 때만 ---
# 이 서버는 위 RAG_SUITE_TOKEN 으로 API 를 호출한다. 주소를 아는 사람은
# 누구나 그 토큰을 태울 수 있다. 터널이나 배포로 공유한다면 아래를 켜라.
# localhost 에서만 쓸 거라면 비워둬도 된다.
#
# 접근 키. 설정하면 http://호스트/?key=<값> 으로만 접속된다.
# APP_ACCESS_KEY=아무거나-긴-문자열
# 연결 1개당 토큰 상한. 잠정 표시를 켠 상태에서 1분 발화가 대략 6,400 토큰.
# MAX_SESSION_TOKENS=50000
